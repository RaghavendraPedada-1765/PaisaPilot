import 'schema.drift';

-- Spending excludes categories with counts_as_spend = 0 (self transfers).
-- Unsorted rows (category_id NULL) count until the user labels them.
-- Dates are ISO text, so a month is txn_date BETWEEN 'YYYY-MM-01' AND 'YYYY-MM-31'.

latestMonth: SELECT MAX(substr(txn_date, 1, 7)) AS month FROM transactions;

-- Spent and received between two ISO dates (inclusive), plus how many
-- transactions of any kind fall in the period, so an empty period can be
-- told apart from one where nothing was spent.
periodTotals: SELECT
  COALESCE(SUM(CASE WHEN t.direction = 'DR' AND (c.id IS NULL OR c.counts_as_spend) THEN t.amount END), 0.0) AS spent,
  COALESCE(SUM(CASE WHEN t.direction = 'CR' AND (c.id IS NULL OR c.counts_as_spend) THEN t.amount END), 0.0) AS received,
  COUNT(*) AS txns
FROM transactions t LEFT JOIN categories c ON c.id = t.category_id
WHERE t.txn_date BETWEEN :from AND :to;

spendByCategory: SELECT c.id AS category_id, c.name AS category,
  SUM(t.amount) AS total, COUNT(*) AS txn_count
FROM transactions t LEFT JOIN categories c ON c.id = t.category_id
WHERE t.txn_date BETWEEN :month || '-01' AND :month || '-31' AND t.direction = 'DR'
  AND (c.id IS NULL OR c.counts_as_spend)
GROUP BY t.category_id
ORDER BY total DESC;

-- :category NULL = every category, 0 = unsorted only (real ids start at 1).
-- :month NULL = all months, else 'YYYY-MM'.
-- :by_amount puts the largest amounts first instead of the newest.
activity(:direction AS TEXT OR NULL, :category AS INTEGER OR NULL, :month AS TEXT OR NULL, :by_amount AS BOOLEAN): SELECT t.**,
  COALESCE(p.display_name, p.raw_name) AS payee, c.name AS category, a.name AS account,
  (SELECT COUNT(*) FROM attachments x WHERE x.txn_id = t.id) AS photos
FROM transactions t
  INNER JOIN accounts a ON a.id = t.account_id
  LEFT JOIN payees p ON p.id = t.payee_id
  LEFT JOIN categories c ON c.id = t.category_id
WHERE (:direction IS NULL OR t.direction = :direction)
  AND (:category IS NULL OR (:category = 0 AND t.category_id IS NULL) OR t.category_id = :category)
  AND (:month IS NULL OR t.txn_date BETWEEN :month || '-01' AND :month || '-31')
  AND (:search = '' OR p.raw_name LIKE '%' || :search || '%'
       OR p.display_name LIKE '%' || :search || '%' OR c.name LIKE '%' || :search || '%')
ORDER BY CASE WHEN :by_amount THEN t.amount ELSE 0 END DESC,
  t.txn_date DESC, t.txn_time DESC, t.id DESC
LIMIT :max_rows;

-- Count and money out / in over every row `activity` matches (not only the
-- rows it returns), so filtered totals stay right past the row limit.
-- Keep the WHERE clause identical to `activity`.
activityTotals(:direction AS TEXT OR NULL, :category AS INTEGER OR NULL, :month AS TEXT OR NULL): SELECT
  COUNT(*) AS n,
  COALESCE(SUM(CASE WHEN t.direction = 'DR' THEN t.amount END), 0.0) AS out_total,
  COALESCE(SUM(CASE WHEN t.direction = 'CR' THEN t.amount END), 0.0) AS in_total
FROM transactions t
  LEFT JOIN payees p ON p.id = t.payee_id
  LEFT JOIN categories c ON c.id = t.category_id
WHERE (:direction IS NULL OR t.direction = :direction)
  AND (:category IS NULL OR (:category = 0 AND t.category_id IS NULL) OR t.category_id = :category)
  AND (:month IS NULL OR t.txn_date BETWEEN :month || '-01' AND :month || '-31')
  AND (:search = '' OR p.raw_name LIKE '%' || :search || '%'
       OR p.display_name LIKE '%' || :search || '%' OR c.name LIKE '%' || :search || '%');

-- Months that have transactions, newest first (for the month filter).
activityMonths: SELECT DISTINCT substr(txn_date, 1, 7) AS month FROM transactions ORDER BY month DESC;
